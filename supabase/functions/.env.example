# Supabase Edge Functions Secrets
# Set these in Supabase Dashboard (Project Settings -> Edge Functions -> Secrets)
# or via CLI: npx supabase secrets set KEY=VALUE

# Primary Model: Google Gemini
GEMINI_API_KEY=

# Fallback Model: Groq API (High-speed LPU failover during peak hours / 503 errors)
GROQ_API_KEY=
# Optional model override (defaults to llama-3.3-70b-versatile, or use llama-3.1-8b-instant):
GROQ_MODEL=llama-3.3-70b-versatile
