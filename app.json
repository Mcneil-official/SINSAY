{
  "expo": {
    "name": "sinsay",
    "slug": "sinsay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/SINSAY-favicon.png",
    "scheme": "sinsay",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mcneilofficialsteam.sinsay",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mcneilofficialsteam.sinsay"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
        "favicon": "./public/SINSAY-favicon.png",
      "name": "SINSAY",
      "shortName": "SINSAY",
      "description": "Eco-Dive Tourism App for Mabini, Batangas",
      "themeColor": "#005AF1",
      "backgroundColor": "#005AF1",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "lang": "en",
      "categories": [
        "travel",
        "lifestyle"
      ],
      "preferRelatedApplications": false,
      "icons": [
          {
            "src": "./public/pwa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
            "src": "./public/pwa-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005AF1",
          "image": "./assets/images/sinsay-white-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/sinsay-white-logo.png",
            "imageWidth": 220
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://sinsay-prod.vercel.app"
      },
      "eas": {
        "projectId": "e43b1547-7151-48a5-8d42-b9f26a471404"
      }
    },
    "owner": "mcneil-officials-team"
  }
}
